generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  feedback  Feedback[]
  reports   Report[]
  themes    Theme[]
  users     User[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
}

model Feedback {
  id             String          @id @default(cuid())
  content        String
  channel        String
  sourceRef      String?
  customerLabel  String?
  sentiment      Sentiment?
  sentimentScore Float?
  status         FeedbackStatus  @default(NEW)
  createdAt      DateTime        @default(now())
  workspaceId    String
  embedding      Embedding?
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  themes         FeedbackTheme[]
}

model Theme {
  id          String          @id @default(cuid())
  name        String
  description String?
  color       String?
  workspaceId String
  feedback    FeedbackTheme[]
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float    @default(1)
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
  theme      Theme    @relation(fields: [themeId], references: [id])

  @@id([feedbackId, themeId])
}

model Embedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  vector     String?
  feedback   Feedback @relation(fields: [feedbackId], references: [id])
}

model Report {
  id          String    @id @default(cuid())
  title       String
  periodStart DateTime
  periodEnd   DateTime
  contentJson String
  createdAt   DateTime  @default(now())
  workspaceId String
  generatedBy String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}
